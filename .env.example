# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> API). Never commit the real `.env`.
#
# The anon key is meant to be public, but it is only safe if Row Level Security (RLS) is enabled
# on every table — see the "Supabase" section of the README.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
